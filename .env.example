APP_NAME="Dyno Ads"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kuala_Lumpur
# Production: APP_URL=https://dynoads.my
# Gambar iklan dan poster dipapar melalui Storage::url(), yang membina URL
# mutlak daripada nilai ini. Salah = setiap gambar pecah walaupun halaman elok.
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FAKER_LOCALE=ms_MY

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Fasa 0: sqlite cukup. Fasa 2 tukar ke mysql.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=dynoads
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# ---------------------------------------------------------------- Meta
# System User token (expiry Never). JANGAN commit fail .env.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_701202512896650
META_PAGE_ID=377330642350146
META_WA_PHONE=60187922844
META_API_VERSION=v21.0

# Rahsia app Meta — perlu untuk sahkan callback pemadaman data.
META_APP_ID=
META_APP_SECRET=

# Butiran syarikat untuk Notis Privasi (PDPA Akta 709 s.7).
# WAJIB diisi sebelum App Review. Jangan reka — guna butiran SSM sebenar.
COMPANY_NAME=
COMPANY_SSM=
COMPANY_ADDRESS=
COMPANY_EMAIL=
COMPANY_PHONE=

# Ayat pra-isi dalam kotak mesej pelanggan bila dia tekan butang WhatsApp iklan.
# Biar kosong = Meta isi ayat Inggerisnya sendiri, dan AI agent akan balas Inggeris.
DYNOADS_WA_PREFILL="Hi, saya nak tahu lanjut pasal ni."

# -------------------------------------------------------------- Poster
# Buang latar gambar produk. 'gd' = tempatan, percuma, tiada API (lalai).
# 'http' = pembekal luar; 'none' = matikan.
DYNOADS_REMOVER_DRIVER=gd
# DYNOADS_REMOVER_ENDPOINT=
# DYNOADS_REMOVER_KEY=

# Latar poster. 'stock' = dijana tempatan, percuma (lalai). 'ai' = pembekal luar.
# Kegagalan AI jatuh balik ke stock — peniaga tetap dapat poster.
DYNOADS_BG_DRIVER=stock
# DYNOADS_BG_ENDPOINT=
# DYNOADS_BG_KEY=
# DYNOADS_BG_MODEL=

# Kosongkan kalau Chromium ada di tempat lalai Playwright.
# PLAYWRIGHT_CHROMIUM_PATH=

# ------------------------------------------------------------- Caption AI
# Pembekal yang menulis caption iklan. openai (lalai) atau claude.
CAPTION_DRIVER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Hanya perlu kalau CAPTION_DRIVER=claude
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
